*{
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    font-family: ;

}
.hero{
    width: 100%;
    height: 100vh;
    background-image: linear-gradient(rgba(12,3,51,0.3),rgba(12,3,51,0.3));
    padding: 0 5%;
    display: flex;
    justify-content: center;
    align-items: center;
    position: relative;
}

.backup-video{
    position: absolute;
    right: 0;
    bottom: 0;
    z-index: -1;


}
.content{
    text-align: center;
}
h1{
    font-size: 100px;
    letter-spacing: 5px;
    color: white;
    
    transition: 0.6s;
}
h1:hover{
    -webkit-text-stroke: 2px white;
    color: transparent;

}
.content a{
    

    font-size: 2rem;
    text-decoration: none;
    color: white;
    font-family:system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, 'Open Sans', 'Helvetica Neue', sans-serif;
    letter-spacing: 10px;
    
    border: 2px solid white;
    border-radius: 10px;
    transition: 0.5s;

}
a:hover{
    color: black;
    background-color: white;
}
